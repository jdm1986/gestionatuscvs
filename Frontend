<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Departamentos</title>
    <link rel="stylesheet" href="styles-departamentos.css">
</head>
<body>
<header>
    <!-- Encabezado con el logo del sistema -->
    <img src="images/logogestionatuscv.png" alt="Logo GestionaTusCV" class="logo">
</header>

<h1>Gestión de Departamentos</h1>

<!-- Formulario para agregar nuevos departamentos -->
<form id="departamentoForm">
    <div class="input-container">
        <!-- Input para el nombre del nuevo departamento -->
        <input type="text" id="nombreDepartamento" placeholder="Nombre del departamento" required>
        <!-- Botón para agregar el departamento -->
        <button type="submit">Agregar Departamento</button>
    </div>
</form>

<!-- Mensaje de error si el departamento ya existe o si ocurre algún otro problema -->
<p id="errorMensaje" style="color:red; display:none;"></p>

<!-- Botón para volver a la página anterior -->
<button id="volverBtn" class="volver-btn">Volver</button>

<!-- Tabla donde se listarán los departamentos ya creados -->
<table id="tablaDepartamentos">
    <thead>
    <tr>
        <th>Nombre</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    <!-- Aquí se agregarán dinámicamente los departamentos -->
    </tbody>
</table>

<!-- Pie de página con enlaces adicionales -->
<footer>
    <div class="footer-content">
        <a href="https://www.jesusdiazmartincv.es" target="_blank">
            <!-- Logo personal del desarrollador -->
            <img src="images/logodeveloper.png" alt="Logo JDM" class="footer-logo">
        </a>
        <div class="footer-links">
            <a href="privacidad.html">Política de Privacidad</a> |
            <a href="terminos.html">Términos y Condiciones</a> |
            <a href="contacto.html">Contacto</a>
        </div>
        <p>&copy; 2024 GESTIONATUSCV. Todos los derechos reservados.</p>
        <p> || Aplicación Web creada por Jesús Díaz Martín || </p>
    </div>
</footer>

<script>
    // URL base que se ajusta dependiendo de si estamos en entorno local o producción
    const baseUrl = window.location.hostname.includes('localhost')
        ? 'http://localhost:8080' // Si es localhost, usar esta URL
        : window.location.hostname.includes('www')
            ? 'https://www.gestionatuscv.es' // Si está en www
            : 'https://gestionatuscv.es'; // Si no está en www


    // Obtiene el userId almacenado en localStorage
    const userId = localStorage.getItem('userId');
    if (!userId) {
        // Si no se encuentra el userId, redirige a la página de login
        window.location.href = '/login.html';
    }

    // Función para cargar los departamentos asociados al usuario actual
    function loadDepartamentos() {
        // Hacemos una petición GET a la API para obtener los departamentos del usuario
        fetch(`${baseUrl}/departamentos?userId=${userId}`)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Error al obtener los departamentos');
                }
                return response.json();
            })
            .then(departamentos => {
                // Limpiamos la tabla antes de cargar nuevos datos
                const tbody = document.getElementById('tablaDepartamentos').querySelector('tbody');
                tbody.innerHTML = '';

                // Recorremos la lista de departamentos recibidos y los añadimos a la tabla
                departamentos.forEach(depto => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${depto.nombre}</td>
                        <td>
                            <button class="eliminar-btn" onclick="confirmDelete(${depto.id})">Eliminar</button>
                        </td>
                    `;
                    tbody.appendChild(row);
                });
            })
            .catch(error => console.error("Error al cargar los departamentos:", error));
    }

    // Función para agregar un nuevo departamento
    document.getElementById('departamentoForm').addEventListener('submit', function(event) {
        event.preventDefault(); // Evitamos el envío tradicional del formulario

        // Obtenemos el nombre del departamento introducido por el usuario
        const nombre = document.getElementById('nombreDepartamento').value.trim();
        const errorMensaje = document.getElementById('errorMensaje');

        // Si el nombre está vacío, mostramos un mensaje de error
        if (!nombre) {
            errorMensaje.textContent = "Por favor, ingresa un nombre de departamento.";
            errorMensaje.style.display = 'block';
            return;
        }

        // Realizamos la petición POST para crear un nuevo departamento
        fetch(`${baseUrl}/departamentos`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            // Enviamos el nombre del departamento y el userId para asociarlo al usuario
            body: JSON.stringify({ nombre, userId })
        })
        .then(response => {
            if (!response.ok) {
                return response.text().then(text => {
                    errorMensaje.textContent = text; // Mostramos el mensaje de error en caso de fallo
                    errorMensaje.style.display = 'block';
                });
            } else {
                errorMensaje.style.display = 'none'; // Ocultamos el mensaje de error si la operación fue exitosa
                return response.json();
            }
        })
        .then(data => {
            if (data) {
                loadDepartamentos(); // Recargamos la lista de departamentos
                document.getElementById('nombreDepartamento').value = ''; // Limpiamos el campo de entrada
            }
        })
        .catch(error => console.error("Error al agregar el departamento:", error));
    });

    // Confirmación antes de eliminar un departamento
    function confirmDelete(id) {
        if (confirm("¿Estás seguro de que quieres eliminar este departamento?")) {
            deleteDepartamento(id); // Si el usuario confirma, eliminamos el departamento
        }
    }

    // Función para eliminar un departamento específico
    function deleteDepartamento(id) {
        fetch(`${baseUrl}/departamentos/${id}`, { method: 'DELETE' })
            .then(() => loadDepartamentos()) // Recargamos los departamentos tras eliminar
            .catch(error => console.error("Error al eliminar el departamento:", error));
    }

    // Botón para volver a la página anterior
    document.getElementById('volverBtn').addEventListener('click', function() {
        window.history.back(); // Regresamos a la página anterior
    });

    // Cargamos los departamentos al cargar la página
    loadDepartamentos();
</script>
</body>
</html>

