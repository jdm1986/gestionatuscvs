<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cambiar Datos del Currículum</title>
    <link rel="stylesheet" href="styles-common.css">
    <link rel="stylesheet" href="styles-dashboard.css">
</head>
<body>
<header>
    <img src="images/logogestionatuscv.png" alt="Logo GestionaTusCV" class="logo" id="logo">
</header>

<div class="container">
    <h1>Cambiar Datos del Currículum</h1>
    <form id="editForm">
        <label for="nombre">Nombre:</label>
        <input type="text" id="nombre" name="nombre" required>

        <label for="apellido">Apellidos:</label>
        <input type="text" id="apellido" name="apellido" required>

        <label for="telefono">Teléfono:</label>
        <input type="text" id="telefono" name="telefono" required>

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" required="">


        <label for="sexo">Sexo:</label>
        <select id="sexo" name="sexo">
            <option value="Hombre">Hombre</option>
            <option value="Mujer">Mujer</option>
            <option value="Otro">Otro</option>
        </select>

        <label for="departamento">Departamento:</label>
        <select id="departamento" name="departamento" required>
            <option value="">Seleccione un departamento</option>
        </select>

        <button type="submit">Guardar</button>
    </form>

    <p id="successMessage" style="display: none; color: green;">Los datos se han guardado con éxito.</p>
</div>

<script>
    // URL base que se ajusta dependiendo de si estamos en entorno local o producción
    const baseUrl = window.location.hostname.includes('localhost')
        ? 'http://localhost:8080' // Si es localhost, usar esta URL
        : window.location.hostname.includes('www')
            ? 'https://www.gestionatuscv.es' // Si está en www
            : 'https://gestionatuscv.es'; // Si no está en www


// Obtener ID del currículum desde la URL
const urlParams = new URLSearchParams(window.location.search);
const curriculumId = urlParams.get('id');

// Obtener el token de autenticación desde localStorage
const token = localStorage.getItem('token');

if (!token) {
    // Si no hay token, redirigir al usuario al login
    alert('Por favor, inicia sesión para continuar.');
    window.location.href = 'login.html';
}

// Función para cargar los datos del currículum
async function loadCurriculumData() {
    try {
        const response = await fetch(`${baseUrl}/curriculums/${curriculumId}`, {
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });

        if (response.ok) {
            const curriculum = await response.json();
            console.log('Curriculum data:', curriculum);  // Agrega un log para ver si los datos llegan correctamente
            document.getElementById('nombre').value = curriculum.nombre;
            document.getElementById('apellido').value = curriculum.apellido;
            document.getElementById('telefono').value = curriculum.telefono;
            document.getElementById('email').value = curriculum.email;
            document.getElementById('sexo').value = curriculum.sexo;

            // Asignar el valor al campo de departamento (luego de cargar opciones)
            const departamentoSelect = document.getElementById('departamento');
            console.log('Curriculum departamento:', curriculum.departamento); // Mover aquí el log

            // Verificamos que se seleccione el departamento correcto
            if (curriculum.departamento) {
                for (let i = 0; i < departamentoSelect.options.length; i++) {
                    if (departamentoSelect.options[i].value === curriculum.departamento) {
                        departamentoSelect.selectedIndex = i;
                        break;
                    }
                }
            } else {
                console.warn('El currículum no tiene un departamento asignado.');
            }

        } else {
            console.error('Error al cargar el currículum:', response.statusText);
            alert('Error al cargar los datos del currículum.');
        }
    } catch (error) {
        console.error('Error al obtener los datos del currículum:', error);
        alert('Error al conectar con el servidor.');
    }
}

async function loadDepartamentos() {
    try {
        // Suponiendo que tienes el userId disponible en el frontend
        const userId = localStorage.getItem('userId'); // Obtén el userId desde localStorage o donde lo tengas guardado

        const response = await fetch(`${baseUrl}/departamentos?userId=${userId}`, {  // Añadimos el userId a la URL
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });

        if (response.ok) {
            const departamentos = await response.json();
            const departamentoSelect = document.getElementById('departamento');
            console.log('Departamentos cargados:', departamentos); // Verificamos si los departamentos se están cargando

            // Agregamos cada departamento al select
            departamentos.forEach(departamento => {
                const option = document.createElement('option');
                option.value = departamento.nombre; // Suponemos que 'nombre' es el valor que se debe usar
                option.text = departamento.nombre;
                departamentoSelect.add(option);
            });

        } else {
            alert('Error al cargar los departamentos.');
        }
    } catch (error) {
        console.error('Error al obtener los departamentos:', error);
        alert('Error al conectar con el servidor.');
    }
}

// Llamar a la función para cargar los datos de departamentos y curriculum cuando se cargue el DOM
document.addEventListener('DOMContentLoaded', async () => {
    await loadDepartamentos(); // Cargamos primero los departamentos
    await loadCurriculumData(); // Luego asignamos el departamento correcto
});


    // Manejo del formulario para guardar los cambios
    document.getElementById('editForm').addEventListener('submit', async function(event) {
    event.preventDefault();

    const nombre = document.getElementById('nombre').value;
    const apellido = document.getElementById('apellido').value;
    const telefono = document.getElementById('telefono').value;
    const email = document.getElementById('email').value;
    const sexo = document.getElementById('sexo').value;
    const departamento = document.getElementById('departamento').value;

    const response = await fetch(`${baseUrl}/curriculums/${curriculumId}`, {
        method: 'PUT',
        headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ nombre, apellido, telefono, email, sexo, departamento })
    });

    if (response.ok) {
        const successMessage = document.getElementById('successMessage');
        successMessage.style.display = 'block'; // Mostrar el mensaje de éxito
        setTimeout(() => {
            window.location.href = 'dashboard.html'; // Redirigir al dashboard después de 2 segundos
        }, 2000);
    } else {
        alert('Error al guardar los datos');
    }
});

</script>
</body>
</html>

