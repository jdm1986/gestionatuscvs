thead th {
    background-color: #e573fe; /* Fondo púrpura para encabezados */
    color: white; /* Texto en blanco */
    padding: 12px; /* Espaciado interior */
    font-size: 16px; /* Tamaño del texto */
    text-align: left; /* Alinear a la izquierda */
