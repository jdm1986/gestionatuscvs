    <h1>Recuperar Contraseña</h1>

    <!--
        Formulario para que el usuario ingrese su correo electrónico y solicite la recuperación de contraseña.
        Incluye un campo de entrada para el email y un botón para enviar la solicitud.
    -->
    <form id="forgotPasswordForm">
        <!-- Campo para introducir el email del usuario -->
        <input type="email" id="email" placeholder="Introduce tu Email" required>
        <!-- Botón para enviar la solicitud de recuperación -->
        <button type="submit">Enviar</button>
        <!-- Botón para volver a la página principal -->
        <button type="button" onclick="location.href='index.html'">Volver</button>
    </form>

    <!--
        Contenedor para mostrar mensajes informativos o de error.
        Inicialmente está oculto y se muestra cuando hay un mensaje que mostrar.
    -->
    <div id="message" class="hidden"></div>
</div>

<!-- Script para manejar el envío del formulario de recuperación de contraseña -->
<script>
    // Evento que se ejecuta al enviar el formulario
    document.getElementById('forgotPasswordForm').addEventListener('submit', async function(event) {
        event.preventDefault(); // Evita el comportamiento por defecto del formulario

        // Obtiene el valor del campo de email
        const email = document.getElementById('email').value;
        const messageContainer = document.getElementById('message');

        // Desactiva el botón para evitar múltiples envíos
        document.querySelector('button[type="submit"]').disabled = true;

        // Realiza la solicitud POST al servidor para enviar la solicitud de recuperación
        const response = await fetch('/auth/forgot-password', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ email: email }) // Envía el email en formato JSON
        });

        if (response.ok) {
            // Si la respuesta es exitosa, muestra un mensaje informativo
            const data = await response.json();
            messageContainer.classList.remove('hidden');
            messageContainer.style.color = '#E573FE'; // Color púrpura para el mensaje de éxito
            messageContainer.textContent = data.message;
            setTimeout(() => {
                window.location.href = 'login.html'; // Redirige al login después de 3 segundos
            }, 3000);
        } else {
            // Si la solicitud falla, muestra el mensaje de error recibido del servidor
            const errorData = await response.json();
            messageContainer.classList.remove('hidden');
            messageContainer.style.color = '#FF6F61'; // Color rojo para el mensaje de error
            messageContainer.textContent = errorData.message;
        }

        // Reactiva el botón después de procesar la solicitud
        document.querySelector('button[type="submit"]').disabled = false;
    });
</script>

