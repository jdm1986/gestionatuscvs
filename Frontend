<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar Contraseña</title>
    <link rel="stylesheet" href="styles-common.css">
</head>
<body>
<header>
    <!-- Página para recuperar la contraseña, permite al usuario ingresar su correo electrónico
         para recibir un enlace de restablecimiento. -->
    <img src="images/logogestionatuscv.png" alt="Logo GestionaTusCV" class="logo" id="logo">
</header>
<div class="container">
    <h1>Recuperar Contraseña</h1>
    <form id="forgotPasswordForm">
        <input type="email" id="email" placeholder="Introduce tu Email" required>
        <button type="submit">Enviar</button>
        <button type="button" onclick="location.href='index.html'">Volver</button>
    </form>
    <!-- Contenedor para mostrar mensajes -->
    <div id="message" class="hidden"></div>
</div>

<!-- Script para manejar el envío del formulario de recuperación de contraseña -->
<script>
    document.getElementById('forgotPasswordForm').addEventListener('submit', async function(event) {
        event.preventDefault();
        const email = document.getElementById('email').value;
        const messageContainer = document.getElementById('message');

        // Desactiva el botón para evitar múltiples envíos
        document.querySelector('button[type="submit"]').disabled = true;

        const response = await fetch('/auth/forgot-password', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ email: email })
        });

        if (response.ok) {
            const data = await response.json();
            messageContainer.classList.remove('hidden');
