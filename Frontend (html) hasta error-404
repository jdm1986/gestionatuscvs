<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subir Currículum</title>
    <link rel="stylesheet" href="styles-common.css">
    <style>
        /* Estilo adicional para el contenedor del checkbox */
        .checkbox-container {
            margin-top: 20px;
            margin-bottom: 20px;
            text-align: left;
            font-size: 14px;
            color: #fff;
            display: flex;
            align-items: center;
        }

        .checkbox-container input {
            margin-right: 10px;
        }

        .checkbox-container label {
            margin: 0;
        }

        .checkbox-container a {
            color: #fff;
            text-decoration: underline;
        }
    </style>
</head>
<body>
<header>
    <!-- Encabezado con el logo de la aplicación -->
    <img src="images/logogestionatuscv.png" alt="Logo GestionaTusCV" class="logo" id="logo">
</header>
<div class="container">
    <h1>Subir Currículum</h1>
    <!-- Formulario para la subida del currículum en formato PDF, con campos adicionales de información personal -->
    <form id="uploadForm">
        <input type="file" id="pdfFile" accept="application/pdf" required>
        <input type="text" id="nombre" placeholder="Nombre" required pattern="[A-Za-zÀ-ÿ\s]+" title="El nombre solo puede contener letras y espacios.">
        <input type="text" id="apellido" placeholder="Apellido" required pattern="[A-Za-zÀ-ÿ\s]+" title="El apellido solo puede contener letras y espacios.">
        <select id="sexo" required>
            <option value="">Seleccionar Sexo</option>
            <option value="Hombre">Hombre</option>
            <option value="Mujer">Mujer</option>
            <option value="Otro">Otro</option>
        </select>
        <select id="departamentoSelect" required>
            <option value="">Seleccionar Departamento</option>
        </select>
        <input type="text" id="telefono" placeholder="Teléfono" required pattern="^\+?[0-9]{9,15}$" title="El teléfono solo puede contener números y opcionalmente el signo + al inicio.">
        <input type="email" id="email" placeholder="Email" required>

        <!-- Checkbox para aceptar los términos de uso y la política de privacidad -->
        <p style="color: #ffffff;">Acepto los <a href="terminos.html" class="link-blanco">Términos de Uso</a> y el <a href="privacidad.html" class="link-blanco">Aviso de Privacidad</a>.</p>
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="aceptarTerminos" required>
        </div>

        <button type="submit">Subir</button>
    </form>
    <!-- Contenedor del spinner -->
    <div id="spinner" class="spinner hidden"></div>
    <!-- Mensajes de confirmación o error -->
    <div id="uploadMessage" class="hidden">Currículum subido exitosamente.</div>
    <div id="errorMessage" class="hidden">Error: Enlace de subida no válido o ha expirado.</div>
</div>

<script>
    // Función para mostrar el spinner
    function showSpinner() {
        document.getElementById('spinner').classList.remove('hidden');
    }

    // Función para ocultar el spinner
    function hideSpinner() {
        document.getElementById('spinner').classList.add('hidden');
    }

    document.addEventListener('DOMContentLoaded', function() {
        // URL base que se ajusta dependiendo de si estamos en entorno local o producción
        const baseUrl = window.location.hostname.includes('localhost')
            ? 'http://localhost:8080' // Si es localhost, usar esta URL
            : window.location.hostname.includes('www')
                ? 'https://www.gestionatuscv.es' // Si está en www
                : 'https://gestionatuscv.es'; // Si no está en www

        const urlParams = new URLSearchParams(window.location.search);
        const token = urlParams.get('token');  // Captura el token desde la URL
        const userId = urlParams.get('userId'); // Captura el userId desde la URL

        // Verifica si el userId está presente en la URL
        if (!userId) {
            console.error("userId no está definido en la URL.");
            alert("No se ha encontrado un userId válido. Por favor, contacta con el administrador.");
            return;
        }

        // Cargar los departamentos desde el servidor para el selector
        fetch(`${baseUrl}/departamentos?userId=${userId}`)
            .then(response => response.json())
            .then(departamentos => {
                const departamentoSelect = document.getElementById('departamentoSelect');
                departamentos.forEach(depto => {
                    const option = document.createElement('option');
                    option.value = depto.nombre;
                    option.textContent = depto.nombre;
                    departamentoSelect.appendChild(option);
                });
            })
            .catch(error => {
                console.error("Error al cargar departamentos:", error);
            });

        // Manejador del formulario de subida
        document.getElementById('uploadForm').addEventListener('submit', function(event) {
            event.preventDefault();
            showSpinner(); // Mostrar spinner al iniciar la subida

            const pdfFile = document.getElementById('pdfFile').files[0];
            const nombre = document.getElementById('nombre').value;
            const apellido = document.getElementById('apellido').value;
            const sexo = document.getElementById('sexo').value;
            const departamento = document.getElementById('departamentoSelect').value;
            const telefono = document.getElementById('telefono').value;
            const email = document.getElementById('email').value;
            const aceptarTerminos = document.getElementById('aceptarTerminos').checked;

            // Validación adicional para asegurarse de que el archivo es un PDF
            if (!pdfFile || pdfFile.type !== "application/pdf") {
                alert('Por favor, sube un archivo PDF válido.');
                hideSpinner(); // Ocultar spinner si hay error
                return;
            }

            // Validación del checkbox de aceptación de términos
            if (!aceptarTerminos) {
                alert('Debe aceptar los términos para poder subir su currículum.');
                hideSpinner(); // Ocultar spinner si hay error
                return;
            }

            const formData = new FormData();
            formData.append('token', token);  // Añadir el token al formData
            formData.append('file', pdfFile);
            formData.append('nombre', nombre);
            formData.append('apellido', apellido);
            formData.append('sexo', sexo);
            formData.append('departamento', departamento);
            formData.append('telefono', telefono);
            formData.append('email', email);

            // Petición para subir el currículum
            fetch(`${baseUrl}/curriculums/upload_with_token`, {
                method: 'POST',
                body: formData
            })
            .then(response => response.text())
            .then(message => {
                hideSpinner(); // Ocultar spinner al finalizar
                if (message.includes("Enlace de subida no válido o ha expirado")) {
                    document.getElementById('errorMessage').classList.remove('hidden');
                } else {
                    document.getElementById('uploadMessage').textContent = message;
                    document.getElementById('uploadMessage').classList.remove('hidden');
                    // Redireccionar al index después de 2 segundos
                    setTimeout(function() {
                        window.location.href = '/index.html';
                    }, 2000);
                }
            })
            .catch(error => {
                hideSpinner(); // Ocultar spinner al finalizar
                alert('Error al subir el currículum.');
            });
        });
    });
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subir Currículum (Usuario)</title>
    <link rel="stylesheet" href="styles-common.css">
    <style>
        /* Estilo adicional para el contenedor del checkbox */
        .checkbox-container {
            margin-top: 20px;
            margin-bottom: 20px;
            text-align: left;
            font-size: 14px;
            color: #fff;
            display: flex;
            align-items: center;
        }

        .checkbox-container input {
            margin-right: 10px;
        }

        .checkbox-container label {
            margin: 0;
        }

        .checkbox-container a {
            color: #fff;
            text-decoration: underline;
        }
    </style>
</head>
<body>
<header>
    <!-- Encabezado con el logo de la aplicación -->
    <img src="images/logogestionatuscv.png" alt="Logo GestionaTusCV" class="logo" id="logo">
</header>
<div class="container">
    <h1>Subir Currículum (Usuario)</h1>
    <!-- Formulario para subir el currículum en formato PDF, con campos adicionales de información personal -->
    <form id="uploadForm">
        <input type="file" id="pdfFile" accept="application/pdf" required>
        <!-- Campos de entrada con validación para nombre y apellido -->
        <input type="text" id="nombre" placeholder="Nombre" required pattern="[A-Za-zÀ-ÿ\s]+" title="El nombre solo puede contener letras y espacios.">
        <input type="text" id="apellido" placeholder="Apellido" required pattern="[A-Za-zÀ-ÿ\s]+" title="El apellido solo puede contener letras y espacios.">
        <select id="sexo" required>
            <option value="">Seleccionar Sexo</option>
            <option value="Hombre">Hombre</option>
            <option value="Mujer">Mujer</option>
            <option value="Otro">Otro</option>
        </select>
        <!-- Selector de departamento cargado dinámicamente -->
        <select id="departamentoSelect" required>
            <option value="">Seleccionar Departamento</option>
        </select>
        <!-- Campo de entrada con validación para el teléfono -->
        <input type="text" id="telefono" placeholder="Teléfono" required pattern="^\+?[0-9]{9,15}$" title="El teléfono solo puede contener números y opcionalmente el signo + al inicio.">
        <input type="email" id="email" placeholder="Email" required>
        <!-- Campo oculto para almacenar el userId -->
        <input type="hidden" id="userId" value="">

        <!-- Checkbox para aceptar los términos y condiciones -->
        <p style="color: #ffffff;">Acepto los <a href="terminos.html" class="link-blanco">Términos de Uso</a> y el <a href="privacidad.html" class="link-blanco">Aviso de Privacidad</a>.</p>
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="aceptarTerminos" required>
        </div>

        <button type="submit">Subir</button>
        <button type="button" id="volverBtn">Volver</button>
    </form>
    <!-- Contenedor del spinner -->
    <div id="spinner" class="spinner hidden"></div>
    <!-- Mensajes de éxito o error -->
    <div id="uploadMessage" class="hidden">Currículum subido exitosamente.</div>
    <div id="errorMessage" class="hidden">Error al subir el currículum.</div>
</div>

<script>
    // Función para mostrar el spinner
    function showSpinner() {
        document.getElementById('spinner').classList.remove('hidden');
    }

    // Función para ocultar el spinner
    function hideSpinner() {
        document.getElementById('spinner').classList.add('hidden');
    }

    document.addEventListener("DOMContentLoaded", function() {
        // URL base que se ajusta dependiendo de si estamos en entorno local o producción
        const baseUrl = window.location.hostname.includes('localhost')
            ? 'http://localhost:8080' // Si es localhost, usar esta URL
            : window.location.hostname.includes('www')
                ? 'https://www.gestionatuscv.es' // Si está en www
                : 'https://gestionatuscv.es'; // Si no está en www

        // Simulando que el userId se obtiene al cargar la página (por ejemplo, desde localStorage)
        const userId = localStorage.getItem('userId');
        if (!userId) {
            alert('Error: userId no encontrado.');
            return;
        }
        document.getElementById('userId').value = userId;

        // Funcionalidad para el botón "Volver"
        document.getElementById('volverBtn').addEventListener('click', function() {
            window.location.href = '/dashboard.html';
        });

        // Añadir confirmación al hacer clic en el logo para cerrar sesión
        document.getElementById('logo').addEventListener('click', function(event) {
            event.preventDefault();
            if (confirm("Se va a cerrar la sesión, ¿estás seguro?")) {
                window.location.href = '/index.html';
            }
        });

        // Cargar los departamentos desde el servidor para el selector
        fetch(`${baseUrl}/departamentos?userId=${userId}`)
            .then(response => {
                if (!response.ok) {
                    return response.json().then(err => { throw new Error(err.error); });
                }
                return response.json();
            })
            .then(departamentos => {
                const departamentoSelect = document.getElementById('departamentoSelect');
                if (Array.isArray(departamentos)) {  // Asegúrate de que departamentos sea un array
                    departamentos.forEach(depto => {
                        const option = document.createElement('option');
                        option.value = depto.nombre;
                        option.textContent = depto.nombre;
                        departamentoSelect.appendChild(option);
                    });
                } else {
                    console.error("Departamentos no es un array:", departamentos);
                }
            })
            .catch(error => {
                console.error('Error al cargar departamentos:', error);
            });

        // Manejo del formulario de subida de currículums
        document.getElementById('uploadForm').addEventListener('submit', function(event) {
            event.preventDefault();
            showSpinner(); // Mostrar spinner al iniciar la subida

            const pdfFile = document.getElementById('pdfFile').files[0];
            const nombre = document.getElementById('nombre').value;
            const apellido = document.getElementById('apellido').value;
            const sexo = document.getElementById('sexo').value;
            const departamento = document.getElementById('departamentoSelect').value;
            const telefono = document.getElementById('telefono').value;
            const email = document.getElementById('email').value;
            const aceptarTerminos = document.getElementById('aceptarTerminos').checked;

            // Validación adicional para asegurarse de que el archivo es un PDF
            if (!pdfFile || pdfFile.type !== "application/pdf") {
                alert('Por favor, sube un archivo PDF válido.');
                hideSpinner(); // Ocultar spinner si hay error
                return;
            }

            // Validación del checkbox de aceptación de términos
            if (!aceptarTerminos) {
                alert('Debe aceptar los términos para poder subir su currículum.');
                hideSpinner(); // Ocultar spinner si hay error
                return;
            }

            const formData = new FormData();
            formData.append('file', pdfFile);
            formData.append('nombre', nombre);
            formData.append('apellido', apellido);
            formData.append('sexo', sexo);
            formData.append('departamento', departamento);
            formData.append('telefono', telefono);
            formData.append('email', email);
            formData.append('userId', userId); // Enviar el userId

            // Petición para subir el currículum
            fetch(`${baseUrl}/curriculums/upload`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('token')}`  // Autenticación con el token del usuario
                },
                body: formData
            })
            .then(response => {
                hideSpinner(); // Ocultar spinner al finalizar
                if (!response.ok) {
                    throw new Error('Error al subir el currículum.');
                }
                return response.json();  // Asumiendo que el servidor devuelve un JSON con la información
            })
            .then(data => {
                document.getElementById('uploadMessage').classList.remove('hidden');
                document.getElementById('errorMessage').classList.add('hidden');

                // Redireccionar al dashboard después de 2 segundos
                setTimeout(function() {
                    window.location.href = '/dashboard.html';
                }, 2000);
            })
            .catch(error => {
                hideSpinner(); // Ocultar spinner al finalizar
                document.getElementById('uploadMessage').classList.add('hidden');
                document.getElementById('errorMessage').classList.remove('hidden');
            });
        });
    });
</script>
</body>
</html>

