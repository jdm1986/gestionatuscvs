    <link rel="stylesheet" href="styles-common.css">
</head>
<body>
<!--
    Encabezado:
    Página para que el usuario restablezca su contraseña usando un token de recuperación enviado por correo electrónico.
    Incluye el logotipo para mantener la identidad visual de la plataforma GestionaTusCV.
-->
<header>
    <img src="images/logogestionatuscv.png" alt="Logo GestionaTusCV" class="logo" id="logo">
</header>

<!-- Contenedor principal para el formulario de restablecimiento de contraseña -->
<div class="container">
    <h1>Restablecer Contraseña</h1>
    <form id="resetPasswordForm">
        <!-- Campo oculto para almacenar el token de restablecimiento -->
        <input type="hidden" id="token" value="">

        <!-- Campo para que el usuario ingrese la nueva contraseña -->
        <input type="password" id="newPassword" placeholder="Nueva Contraseña" required>

        <!-- Botón para enviar el formulario de restablecimiento -->
        <button type="submit">Restablecer Contraseña</button>
    </form>
</div>

<!-- Script para manejar el proceso de restablecimiento de contraseña -->
<script>
    // URL base del entorno de producción
    const baseUrl = 'https://gestionatuscv.es';

    // Función que se ejecuta cuando la página ha sido cargada completamente
    document.addEventListener('DOMContentLoaded', function() {
        // Obtener el token desde la URL (parámetro "token" en la cadena de consulta)
        const params = new URLSearchParams(window.location.search);
        const token = params.get('token');
        document.getElementById('token').value = token; // Asignar el token al campo oculto

        // Agregar un evento para manejar el envío del formulario
        document.getElementById('resetPasswordForm').addEventListener('submit', async function(event) {
            event.preventDefault(); // Prevenir el comportamiento por defecto del formulario

            // Obtener la nueva contraseña ingresada por el usuario
            const newPassword = document.getElementById('newPassword').value;

            // Realizar la solicitud POST para restablecer la contraseña
            const response = await fetch(baseUrl + '/auth/reset-password', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded' // Enviar los datos en formato URL codificada
                },
                body: new URLSearchParams({
                    token: token, // El token proporcionado
                    newPassword: newPassword // La nueva contraseña
                })
            });

            // Verificar la respuesta del servidor
            if (response.ok) {
                // Si la solicitud fue exitosa, mostrar un mensaje y redirigir al inicio de sesión
                alert('Contraseña restablecida correctamente');
                window.location.href = 'login.html';
            } else {
                // Si hubo un error, mostrar un mensaje de alerta
                alert('Error al restablecer la contraseña');
            }
        });
    });
</script>

</body>

