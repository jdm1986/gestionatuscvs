<script>
    // URL base del servidor, se ajusta dependiendo del entorno (local o producción)
    const baseUrl = window.location.hostname.includes('localhost')
        ? 'http://localhost:8080' // URL en entorno de desarrollo (localhost)
        : window.location.hostname.includes('www')
            ? 'https://www.gestionatuscv.es' // URL con "www" en producción
            : 'https://gestionatuscv.es'; // URL sin "www" en producción

    // Obtiene el userId del usuario almacenado en localStorage
    const userId = localStorage.getItem('userId');
    if (!userId) {
        // Si no hay un userId almacenado, se redirige al usuario a la página de inicio de sesión
        window.location.href = '/login.html';
    }

    // Función para cargar los departamentos asociados al usuario actual
    function loadDepartamentos() {
        // Realiza una solicitud GET al servidor para obtener los departamentos del usuario
        fetch(`${baseUrl}/departamentos?userId=${userId}`)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Error al obtener los departamentos');
                }
                return response.json();
            })
            .then(departamentos => {
                // Limpiamos la tabla antes de cargar los nuevos datos
                const tbody = document.getElementById('tablaDepartamentos').querySelector('tbody');
                tbody.innerHTML = '';

                // Agrega cada departamento a la tabla
                departamentos.forEach(depto => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${depto.nombre}</td>
                        <td>
                            <button class="eliminar-btn" onclick="confirmDelete(${depto.id})">Eliminar</button>
                        </td>
                    `;
                    tbody.appendChild(row);
                });
            })
            .catch(error => console.error("Error al cargar los departamentos:", error));
    }

    // Evento que se ejecuta al enviar el formulario de nuevo departamento
    document.getElementById('departamentoForm').addEventListener('submit', function(event) {
        event.preventDefault(); // Evita el envío del formulario por defecto

        // Obtiene el nombre del departamento ingresado por el usuario
        const nombre = document.getElementById('nombreDepartamento').value.trim();
        const errorMensaje = document.getElementById('errorMensaje');

        // Verifica que el campo no esté vacío
        if (!nombre) {
            errorMensaje.textContent = "Por favor, ingresa un nombre de departamento.";
            errorMensaje.style.display = 'block';
            return;
        }

        // Realiza la solicitud para agregar un nuevo departamento
        fetch(`${baseUrl}/departamentos`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ nombre, userId }) // Envia el nombre del departamento y el userId
        })
        .then(response => {
            if (!response.ok) {
                return response.text().then(text => {
                    errorMensaje.textContent = text; // Muestra el error recibido del servidor
                    errorMensaje.style.display = 'block';
                });
            } else {
                errorMensaje.style.display = 'none'; // Oculta el mensaje de error si no hubo problemas
                return response.json();
            }
        })
        .then(data => {
            if (data) {
                loadDepartamentos(); // Recarga la lista de departamentos
                document.getElementById('nombreDepartamento').value = ''; // Limpia el campo de entrada
            }
        })
        .catch(error => console.error("Error al agregar el departamento:", error));
    });

    // Confirma antes de eliminar un departamento
    function confirmDelete(id) {
        if (confirm("¿Estás seguro de que quieres eliminar este departamento?")) {
            deleteDepartamento(id); // Llama a la función de eliminación si se confirma
        }
    }

    // Función para eliminar un departamento del servidor
    function deleteDepartamento(id) {
        fetch(`${baseUrl}/departamentos/${id}`, { method: 'DELETE' })
            .then(() => loadDepartamentos()) // Recarga la lista de departamentos después de eliminar
            .catch(error => console.error("Error al eliminar el departamento:", error));
    }

    // Redirige a la página anterior al hacer clic en el botón "Volver"
    document.getElementById('volverBtn').addEventListener('click', function() {
        window.history.back(); // Vuelve a la página anterior
    });

    // Carga los departamentos al cargar la página
    loadDepartamentos();
</script>
</body>
