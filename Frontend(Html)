<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Departamentos</title>
    <link rel="stylesheet" href="styles-departamentos.css">
</head>
<body>
<!--
    Página de gestión de departamentos.
    Permite a los usuarios agregar nuevos departamentos, ver la lista de departamentos existentes,
    y eliminar departamentos según sea necesario.
-->

<header>
    <!-- Logo de la aplicación que aparece en la parte superior de la página -->
    <img src="images/logogestionatuscv.png" alt="Logo GestionaTusCV" class="logo">
</header>

<!-- Título principal de la página -->
<h1>Gestión de Departamentos</h1>

<!--
    Formulario para agregar nuevos departamentos.
    El formulario contiene un campo para el nombre del departamento y un botón para agregarlo.
-->
<form id="departamentoForm">
    <div class="input-container">
        <!-- Campo de entrada para el nombre del departamento -->
        <input type="text" id="nombreDepartamento" placeholder="Nombre del departamento" required>
        <!-- Botón para agregar el departamento a la lista -->
        <button type="submit">Agregar Departamento</button>
    </div>
</form>

<!-- Mensaje de error, se muestra en caso de que ocurra algún problema al agregar un departamento -->
<p id="errorMensaje" style="color:red; display:none;"></p>

<!-- Botón para volver a la página anterior -->
<button id="volverBtn" class="volver-btn">Volver</button>

<!--
    Tabla para mostrar la lista de departamentos existentes.
    Incluye un encabezado con los nombres de las columnas y el cuerpo de la tabla donde se agregarán
    dinámicamente los departamentos cargados desde el servidor.
-->
<table id="tablaDepartamentos">
    <thead>
    <tr>
        <th>Nombre</th> <!-- Columna para el nombre del departamento -->
