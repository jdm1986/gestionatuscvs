    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CONTACTO</title>
    <link rel="stylesheet" href="styles-common.css">
</head>
<body>
<!--
    Página de contacto que permite a los usuarios enviar un mensaje a través de un formulario.
    Utiliza un script para hacer una petición POST al backend con los datos del formulario.
-->

<header>
    <!-- Cabecera de la página con el logo. El logo puede servir como enlace para volver a la página principal. -->
    <img src="images/logogestionatuscv.png" alt="Logo GestionaTusCV" class="logo" id="logo">
</header>

<div class="container">
    <!-- Título principal de la página de contacto -->
    <h1>CONTACTO</h1>

    <!--
        Formulario para que los usuarios introduzcan su nombre, correo electrónico y mensaje.
        Todos los campos son obligatorios para garantizar que la información sea completa.
    -->
    <form id="contactForm">
        <!-- Campo de texto para el nombre del usuario -->
        <input type="text" id="name" placeholder="Tu nombre" required>
        <!-- Campo de entrada para el correo electrónico del usuario -->
        <input type="email" id="email" placeholder="Tu correo electrónico" required>
        <!-- Área de texto para el mensaje del usuario -->
        <textarea id="message" placeholder="Tu mensaje" required style="margin-bottom: 10px;"></textarea>

        <!-- Botón para enviar el formulario con la información proporcionada -->
        <button type="submit">Enviar</button>

        <!-- Botón para regresar a la página de inicio. Utiliza la función "location.href" para redirigir -->
        <button type="button" onclick="location.href='index.html'">Volver</button>
    </form>

    <!-- Mensaje de confirmación que se muestra cuando el envío del formulario es exitoso -->
    <div id="confirmationMessage" class="hidden">
        Tu mensaje ha sido enviado. Nos pondremos en contacto contigo pronto.
    </div>
</div>

<!--
    Script para manejar el evento de envío del formulario.
    Se encarga de capturar los datos ingresados y enviar una solicitud al servidor.
-->
<script>
    document.getElementById('contactForm').addEventListener('submit', async function(event) {
        event.preventDefault(); // Evita el comportamiento por defecto del formulario

        // Capturo los valores de los campos del formulario
        const name = document.getElementById('name').value;
        const email = document.getElementById('email').value;
        const message = document.getElementById('message').value;

        // Construyo la URL completa usando el valor correcto de la base URL
        const appBaseUrl = window.location.origin; // Obtiene la base de la URL actual

        // Realizo una solicitud POST al backend con los datos del formulario en formato JSON
        const response = await fetch(`${appBaseUrl}/contact`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json' // Indica que el cuerpo de la solicitud es JSON
            },
            body: JSON.stringify({
                name: name, // Incluye el nombre proporcionado
                email: email, // Incluye el correo proporcionado
                message: message // Incluye el mensaje proporcionado
            })
        });

        if (response.ok) {
            // Si el mensaje se envía correctamente, muestro el mensaje de confirmación y limpio el formulario
            document.getElementById('confirmationMessage').classList.remove('hidden');
            document.getElementById('contactForm').reset(); // Restablezco el formulario a su estado inicial
        } else {
            alert('Hubo un error al enviar el mensaje. Por favor, inténtalo de nuevo.'); // Mensaje de error si la solicitud falla
        }
    });
</script>

<!--
    Script adicional para funcionalidades generales que puedan ser necesarias en la página.
    Por ejemplo, validaciones extra o manejo de eventos del DOM.
-->
<script src="scripts.js"></script>

<!-- Pie de página con enlaces a políticas, términos y referencia al desarrollador -->
