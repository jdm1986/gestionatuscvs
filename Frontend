    color: white; /* Texto blanco */
}

/* Estilo para los botones de búsqueda */
.search-buttons {
    display: flex; /* Uso de flexbox */
    justify-content: center; /* Centrado */
    width: 100%; /* Ocupa todo el ancho disponible */
    max-width: 100px; /* Ancho máximo de 100px */
    margin-top: 10px; /* Espaciado superior */
    flex-direction: row; /* Elementos en fila */
    gap: 10px; /* Espacio entre botones */
}

/* Estilo del contenedor de enlace generado */
.link-container {
    display: none; /* Oculta el contenedor */
    flex-direction: column; /* Coloca los elementos en columna */
    align-items: center; /* Alinea al centro */
    margin-top: 10px; /* Espaciado superior */
    width: 100%; /* Ancho completo */
}

.link-container.show {
    display: flex; /* Muestra el contenedor con flexbox */
}

.generated-link {
    background-color: #444444; /* Fondo gris oscuro */
    color: white; /* Texto blanco */
    padding: 10px; /* Relleno interno */
    border-radius: 8px; /* Bordes redondeados */
    margin-bottom: 10px; /* Espaciado inferior */
    word-wrap: break-word; /* Ajusta el texto largo */
    text-align: center; /* Texto centrado */
    max-width: 100%; /* Ocupa todo el ancho disponible */
}

.copy-button {
    display: none; /* Oculta el botón */
    background-color: #7C3E8A; /* Fondo morado */
    color: white; /* Texto blanco */
    border: none; /* Sin borde */
    padding: 10px 20px; /* Relleno interno */
    cursor: pointer; /* Cambia el cursor a mano */
    border-radius: 4px; /* Bordes redondeados */
    font-size: 14px; /* Tamaño de fuente */
    box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1); /* Sombra ligera */
    transition: background-color 0.3s ease; /* Transición suave */
}

.copy-button.show {
    display: inline-block; /* Muestra el botón en línea */
}

.copy-button:hover {
    background-color: #E573FE; /* Fondo rosado al pasar el cursor */
}

/* Estilos de la tabla */
.results {
    max-height: 70vh; /* Altura máxima del 70% */
    overflow-y: auto; /* Desplazamiento vertical si es necesario */
    background-color: #333333; /* Fondo gris oscuro */
    padding: 15px; /* Relleno interno */
    border-radius: 8px; /* Bordes redondeados */
    margin-top: 20px; /* Espaciado superior */
}

/* Estilos para la tabla */
table {
    width: 100%; /* Ocupa todo el ancho disponible */
    border-collapse: collapse; /* Colapsa los bordes */
    background-color: #2c2c2c; /* Fondo gris oscuro */
    border-radius: 8px; /* Bordes redondeados */
    overflow: hidden; /* Ocultar desbordes */
}

/* Estilos para los encabezados de la tabla */
thead th {
    background-color: #e573fe; /* Fondo rosado */
    color: white; /* Texto blanco */
    padding: 12px; /* Relleno de 12px */
    font-size: 16px; /* Tamaño de fuente */
    text-align: left; /* Texto alineado a la izquierda */
}

/* Estilos de botones */
.icon-button {
    background-color: #E573FE; /* Fondo rosado */
    color: white; /* Texto blanco */
    border: none; /* Sin borde */
    padding: 8px; /* Relleno interno */
    cursor: pointer; /* Cambia el cursor a mano */
    border-radius: 5px; /* Bordes redondeados */
    font-size: 16px; /* Tamaño de fuente */
    display: inline-flex; /* Elementos en línea con flexbox */
    align-items: center; /* Alineación centrada verticalmente */
    justify-content: center; /* Alineación centrada horizontalmente */
    width: 40px; /* Ancho fijo de 40px */
    height: 40px; /* Altura fija de 40px */
    box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1); /* Sombra ligera */
    transition: background-color 0.3s ease, transform 0.2s ease; /* Transición suave */
    margin-right: 5px; /* Espaciado derecho */
}

.icon-button i {
    font-size: 18px; /* Tamaño del icono */
}

.icon-button:hover {
    background-color: #7C3E8A; /* Cambio de fondo al pasar el cursor */
    transform: scale(1.1); /* Aumenta el tamaño */
}

.icon-button:active {
    transform: scale(0.95); /* Reduce el tamaño al hacer clic */
}

.action-buttons {
    display: flex; /* Uso de flexbox */
    justify-content: flex-end; /* Alinea a la derecha */
    gap: 5px; /* Espaciado entre botones */
}

/* Ajustes responsivos para pantallas pequeñas */
@media (max-width: 1280px) {
    /* Asegurarse de que los botones se apilen en dispositivos móviles */
    .action-buttons {
        justify-content: flex-end; /* Alineación a la derecha */
        gap: 5px; /* Espacio entre botones */
        width: 48%; /* Ancho reducido al 48% */
        margin: 0; /* Sin margen */
    }

    .icon-button {
            width: 30px; /* Ancho reducido a 30px */
            height: 30px; /* Altura reducida a 30px */
            font-size: 12px; /* Tamaño de fuente reducido */
        }

    .container {
        width: auto; /* Ancho automático */
        padding: 20px; /* Relleno interno */
    }

    .results {
        max-height: 50vh; /* Altura máxima del 50% */
        overflow-y: auto; /* Desplazamiento vertical si es necesario */
        background-color: #333333; /* Fondo gris oscuro */
        padding: 10px; /* Relleno interno */
        border-radius: 8px; /* Bordes redondeados */
        margin-top: 20px; /* Espaciado superior */
    }

    table {
        width: 100%; /* Ancho completo */
        border-collapse: collapse; /* Colapsa los bordes */
    }

    thead {
        display: none; /* Oculta el encabezado en móviles */
    }

    tbody tr {
        border-bottom: 1px solid #333; /* Línea inferior de las filas */
        margin-bottom: 10px; /* Espaciado inferior */
    }

    tbody td {
        display: block; /* Muestra las celdas como bloques */
        text-align: end; /* Texto alineado a la derecha */
        padding: 10px; /* Relleno interno */
        border-bottom: 1px solid #444; /* Línea inferior */
        position: relative; /* Posiciona de manera relativa */
        padding-left: 50%; /* Relleno a la izquierda */
        white-space: normal; /* Permite que el texto ocupe varias líneas si es necesario */
        overflow: visible; /* Evita el desbordamiento del texto */
        text-overflow: clip; /* Evitar truncamiento con puntos suspensivos */
    }

    tbody td::before {
        content: attr(data-label); /* Muestra el atributo data-label */
        position: absolute; /* Posiciona el contenido absolutamente */
        left: 10px; /* Posición izquierda */
        width: 45%; /* Ancho del 45% */
        padding-right: 10px; /* Relleno derecho */
        white-space: nowrap; /* Evita que el texto se desborde */
        text-align: left; /* Alineación a la izquierda */
        font-weight: bold; /* Negrita */
    }

    tbody td .action-buttons {
        justify-content: flex-end; /* Alinea los botones a la derecha */
    }

    tbody td button {
        padding: 5px 10px; /* Relleno interno */
        cursor: pointer; /* Cambia el cursor a mano */
    }

    tbody td button:hover {
        background-color: #7C3E8A; /* Cambio de fondo al pasar el cursor */
    }

    /* Ajustar tamaño del botón "Ver registros de usuarios" y centrar */
    #viewLogsButton {
        width: 80%; /* Ancho reducido al 80% */
        margin: 10px auto; /* Centrado automático */
    }
}

/* Estilos para el modal */
.modal {
    display: none; /* Oculta el modal por defecto */
    position: fixed; /* Posición fija */
    z-index: 1; /* Capas encima de otros elementos */
    left: 0; /* Alineado a la izquierda */
    top: 0; /* Alineado en la parte superior */
    width: 100%; /* Ancho completo */
    height: 100%; /* Altura completa */
    overflow: auto; /* Permite desplazamiento */
    background-color: rgba(0,0,0,0.4); /* Fondo oscuro semi-transparente */
    padding-top: 60px; /* Espaciado superior */
}

.modal-content {
    background-color: #45224D; /* Fondo morado oscuro */
    margin: 18% auto; /* Centrado automático */
    padding: 1px; /* Relleno mínimo */
    border: 1px solid #888; /* Borde gris */
    width: 90%; /* Ancho del 90% */
