# Copia este archivo como .env y rellena los valores

# Base de datos
MYSQL_DATABASE=gestioncv
MYSQL_USER=appuser
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# JWT
JWT_SECRET=

# URL base de la app
APP_BASEURL=http://localhost:8080

# Email (al menos uno de los dos)
SENDGRID_API_KEY=
RESEND_API_KEY=
APP_MAIL_FROM=
APP_MAIL_ADMIN=

# Directorio de almacenamiento de CVs (opcional, default: uploads)
# APP_STORAGE_DIR=/data/uploads
