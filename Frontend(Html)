<!-- Script para manejar el proceso de restablecimiento de contraseña -->
<script>
    // URL base del entorno de producción
    const baseUrl = 'https://gestionatuscv.es';

    // Función que se ejecuta cuando la página ha sido cargada completamente
    document.addEventListener('DOMContentLoaded', function() {
        // Obtener el token desde la URL (parámetro "token" en la cadena de consulta)
        const params = new URLSearchParams(window.location.search);
